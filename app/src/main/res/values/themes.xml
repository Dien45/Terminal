<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Terminal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:windowBackground">@color/background_white</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/primary_blue_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/primary_blue_dark</item>
    </style>

    <style name="Theme.Terminal.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Terminal.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />
</resources>
